# syntax=docker/dockerfile:1
# The Android app (a shell that opens the server, see capacitor.config.ts), built in its own
# image so the server's stays small: `./scripts/apk.sh` (run by `./scripts/serve.sh --funnel`).
# Every step is cached: it only really rebuilds when android/, native/, capacitor.config.ts,
# the dependencies or the server URL change. The container just copies the APK into data/.
FROM node:26-bookworm-slim

COPY --from=eclipse-temurin:21-jdk /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk \
    ANDROID_HOME=/opt/android \
    PATH=/opt/java/openjdk/bin:/opt/android/cmdline-tools/latest/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends curl unzip ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Android SDK: command-line tools, then the platform the app compiles against
# (android/variables.gradle). Gradle fetches anything else it needs (licenses accepted here).
ARG CMDLINE_TOOLS=11076708
RUN curl -fsSL "https://dl.google.com/android/repository/commandlinetools-linux-${CMDLINE_TOOLS}_latest.zip" -o /tmp/tools.zip \
 && mkdir -p "$ANDROID_HOME/cmdline-tools" \
 && unzip -q /tmp/tools.zip -d "$ANDROID_HOME/cmdline-tools" \
 && mv "$ANDROID_HOME/cmdline-tools/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest" \
 && rm /tmp/tools.zip \
 && (yes | sdkmanager --licenses >/dev/null) \
 && sdkmanager --install "platforms;android-36" "platform-tools" >/dev/null

WORKDIR /src
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts

COPY capacitor.config.ts ./
COPY native native
COPY android android

# The address the app opens: the Funnel's (a real certificate: the WebView refuses the LAN's
# self-signed one).
ARG CAP_SERVER_URL
RUN test -n "$CAP_SERVER_URL" || { echo "CAP_SERVER_URL is required" >&2; exit 1; }
RUN --mount=type=cache,target=/root/.gradle \
    CAP_SERVER_URL="$CAP_SERVER_URL" npx cap sync android \
 && cd android && ./gradlew --no-daemon -q assembleDebug \
 && cp app/build/outputs/apk/debug/app-debug.apk /tape-twist.apk && chmod 644 /tape-twist.apk

CMD ["cp", "/tape-twist.apk", "/out/tape-twist.apk"]
